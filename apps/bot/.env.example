# Meta for Developers → seu app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Qualquer string; você informa a mesma no cadastro do webhook
WHATSAPP_VERIFY_TOKEN=troque-este-valor
# App Secret (Configurações do app → Básico). Habilita a validação da assinatura
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0
PORT=3000
# URL pública do site (link de pagamento por cartão)
SITE_URL=https://matheusgomesrocha.github.io/navalha-club/
