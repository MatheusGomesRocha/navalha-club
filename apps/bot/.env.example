# Meta for Developers → seu app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Qualquer string; você informa a mesma no cadastro do webhook
WHATSAPP_VERIFY_TOKEN=troque-este-valor
# App Secret (Configurações do app → Básico). Habilita a validação da assinatura
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0
PORT=3000
# URL pública do site (link de pagamento por cartão)
SITE_URL=https://matheusgomesrocha.github.io/navalha-club/

# --- Canal de teste: Twilio Sandbox for WhatsApp (opcional) ---
# Não precisa de credenciais para responder: a rota POST /twilio responde em TwiML.
# Se quiser validar a assinatura das requisições, preencha os dois:
TWILIO_AUTH_TOKEN=
# URL pública exata cadastrada na Twilio, ex.: https://seu-tunel.trycloudflare.com/twilio
TWILIO_WEBHOOK_URL=
